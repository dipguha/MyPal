# MyPal backend environment — copy to .env and fill in. See backend/CLAUDE.md.

# Database (hostname `db` = docker-compose Postgres service)
DATABASE_URL=postgresql://mypal:mypal@db:5432/mypal_development
TEST_DATABASE_URL=postgresql://mypal:mypal@db:5432/mypal_test

RAILS_ENV=development
ALLOWED_ORIGINS=http://localhost:3000
# SECRET_KEY_BASE=<generate with `bin/rails secret` for production>

# AWS Cognito — from Secrets Manager mypal-<env>/cognito/web-bff
AWS_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
