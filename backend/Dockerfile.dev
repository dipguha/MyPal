# Development image for the MyPal Rails API.
# The production build lives in ./Dockerfile (generated by Rails, used by Kamal/ECS).
# Here gems are installed at runtime into the `bundle_data` volume (see docker-compose.yml)
# so the host bind-mount stays live-editable.
ARG RUBY_VERSION=3.3.11
FROM docker.io/library/ruby:$RUBY_VERSION

# System deps: build native gems (pg), plus a psql client for db tasks.
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git libpq-dev libyaml-dev pkg-config postgresql-client && \
    rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/usr/local/bundle \
    RAILS_ENV=development

WORKDIR /app

EXPOSE 3001
CMD ["bash"]
