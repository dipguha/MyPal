# NextAuth (server-side; never prefixed NEXT_PUBLIC_)
# Generate a strong secret:  openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Cognito — confidential app client (with secret) used by Next.js BFF
COGNITO_ISSUER=https://cognito-idp.eu-west-1.amazonaws.com/<USER_POOL_ID>
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# FastAPI base URL the BFF proxies to. Same-origin in deployed envs (ALB
# path rule). In local dev, point at the running FastAPI container/process.
FASTAPI_INTERNAL_URL=http://localhost:8000
