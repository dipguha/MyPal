# ============================================================
# OS & editors
# ============================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ============================================================
# Secrets & credentials (never commit these)
# ============================================================
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
!.env.*.example

# ============================================================
# Terraform / Infrastructure
# ============================================================

# Local state (use remote backend — S3 — instead)
**/.terraform/
**/terraform.tfstate
**/terraform.tfstate.*
**/.terraform.tfstate.lock.info

# tfvars files may contain secrets; only .example variants are committed
**/terraform.tfvars
!**/terraform.tfvars.example

# Crash logs
**/crash.log
**/crash.*.log

# Override files are user-local
**/override.tf
**/override.tf.json
**/*_override.tf
**/*_override.tf.json

# CLI config file (contains credentials)
**/.terraformrc
**/terraform.rc

# Generated plan files
*.tfplan
*.tfplan.json

# ============================================================
# Ruby on Rails (backend/)
# ============================================================
backend/.bundle/
backend/vendor/bundle/
backend/tmp/
backend/log/
backend/public/system/
backend/public/assets/
backend/public/packs/
backend/storage/
backend/.byebug_history
backend/.ruby-version

# Rails credentials — keep config/credentials.yml.enc but not master.key
backend/config/master.key
backend/config/credentials/*.key

# ============================================================
# Next.js / Node (frontend/)
# ============================================================
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/next-env.d.ts
frontend/.vercel

# ============================================================
# Root-level Node (scripts, tooling)
# ============================================================
node_modules/
.pnp
.pnp.js
coverage/
*.tsbuildinfo

# ============================================================
# Debug logs
# ============================================================
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
